{
  "name": "kylestacklin.github.io",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://kylestacklin.github.io",
  "dependencies": {
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^27.5.2",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "clsx": "^2.1.1",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-jss": "^10.10.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "vitest run",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,mjs,cjs,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,mjs,cjs,jsx,ts,tsx}",
      "!**/src/RiskOfRain2/__tests__/**"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "gh-pages": "^6.2.0",
    "jsdom": "^31.0.1",
    "vitest": "^3.2.7"
  }
}
